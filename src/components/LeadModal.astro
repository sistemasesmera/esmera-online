---
import LeadForm from "./LeadForm.astro";
import Icon from "./Icon.astro";
---

<div
  id="lead-modal"
  data-lead-modal
  class="fixed inset-0 z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200"
  aria-hidden="true"
>
  <div data-lead-modal-backdrop class="absolute inset-0 bg-ink-950/60 backdrop-blur-sm"></div>

  <div class="relative max-h-[90vh] w-full max-w-lg overflow-y-auto">
    <button
      type="button"
      data-lead-modal-close
      aria-label="Cerrar"
      class="absolute right-4 top-4 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white text-ink-500 shadow-md transition-colors duration-150 hover:bg-ink-50 hover:text-ink-900"
    >
      <Icon name="close" class="h-4 w-4" />
    </button>
    <LeadForm
      title="Habla con un asesor educativo"
      subtitle="Déjanos tus datos y un asesor educativo te contacta para orientarte sin compromiso."
    />
  </div>
</div>

<script>
  function initLeadModal() {
    const modal = document.querySelector<HTMLElement>("[data-lead-modal]");
    if (!modal || modal.dataset.bound) return;
    modal.dataset.bound = "true";

    const backdrop = modal.querySelector<HTMLElement>("[data-lead-modal-backdrop]");
    const closeButton = modal.querySelector<HTMLElement>("[data-lead-modal-close]");

    const titleEl    = modal.querySelector<HTMLElement>("h3");
    const subtitleEl = modal.querySelector<HTMLElement>("h3 + p");
    const form       = modal.querySelector<HTMLFormElement>("#lead-form");

    const defaultTitle    = titleEl?.textContent ?? "";
    const defaultSubtitle = subtitleEl?.textContent ?? "";

    const open = (courseName?: string) => {
      // Campos que ocultamos en modo curso
      const courseRow  = modal.querySelector<HTMLElement>("#lead-course")?.closest("div") ?? null;
      const messageRow = modal.querySelector<HTMLElement>("#lead-message")?.closest("div") ?? null;

      // Elimina hidden input previo si existe
      modal.querySelector<HTMLInputElement>('input[name="courseOfInterest"]')?.remove();

      if (courseName && form) {
        // Inyecta curso como campo oculto
        const hidden = document.createElement("input");
        hidden.type  = "hidden";
        hidden.name  = "courseOfInterest";
        hidden.value = courseName;
        form.prepend(hidden);

        // Oculta selector de curso y mensaje
        if (courseRow)  courseRow.style.display  = "none";
        if (messageRow) messageRow.style.display = "none";

        if (titleEl)    titleEl.textContent    = "¿Tienes dudas sobre este curso?";
        if (subtitleEl) subtitleEl.textContent = "Déjanos tus datos y un asesor te contacta en menos de 24 h.";
      } else {
        // Restaura estado por defecto
        if (courseRow)  courseRow.style.display  = "";
        if (messageRow) messageRow.style.display = "";
        if (titleEl)    titleEl.textContent    = defaultTitle;
        if (subtitleEl) subtitleEl.textContent = defaultSubtitle;
      }

      modal.classList.remove("opacity-0", "pointer-events-none");
      modal.setAttribute("aria-hidden", "false");
      document.body.classList.add("overflow-hidden");
      modal.querySelector<HTMLInputElement>("#lead-name")?.focus();
    };

    const close = () => {
      modal.classList.add("opacity-0", "pointer-events-none");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("overflow-hidden");
      // Restaura estado por defecto al cerrar
      const courseRow  = modal.querySelector<HTMLElement>("#lead-course")?.closest("div") ?? null;
      const messageRow = modal.querySelector<HTMLElement>("#lead-message")?.closest("div") ?? null;
      modal.querySelector<HTMLInputElement>('input[name="courseOfInterest"]')?.remove();
      if (courseRow)  courseRow.style.display  = "";
      if (messageRow) messageRow.style.display = "";
      if (titleEl)    titleEl.textContent    = defaultTitle;
      if (subtitleEl) subtitleEl.textContent = defaultSubtitle;
    };

    backdrop?.addEventListener("click", close);
    closeButton?.addEventListener("click", close);

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && modal.getAttribute("aria-hidden") === "false") close();
    });

    document.addEventListener("click", (event) => {
      const trigger = (event.target as HTMLElement)?.closest<HTMLElement>("[data-lead-modal-trigger]");
      if (!trigger) return;
      event.preventDefault();
      open(trigger.dataset.leadCourse);
    });
  }

  document.addEventListener("astro:page-load", initLeadModal);
</script>
