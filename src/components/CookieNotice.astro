---
import Container from "./ui/Container.astro";
---

<div
  id="cookie-notice"
  data-cookie-notice
  class="fixed inset-x-0 bottom-0 z-[90] translate-y-full border-t border-white/10 bg-ink-950 text-ink-300 shadow-[0_-8px_30px_-10px_rgba(0,0,0,0.3)] transition-transform duration-300"
>
  <Container class="flex flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm leading-relaxed text-ink-300">
      Usamos cookies propias y de terceros para analizar el uso del sitio y mejorar tu experiencia.
      <a href="/cookies" class="underline hover:text-white">Más información</a>.
    </p>
    <div class="flex shrink-0 gap-3">
      <button
        type="button"
        data-cookie-reject
        class="rounded-lg border border-ink-700 px-4 py-2.5 font-display text-sm font-semibold text-ink-300 transition-colors hover:border-ink-500 hover:text-white"
      >
        Rechazar
      </button>
      <button
        type="button"
        data-cookie-accept
        class="rounded-lg bg-brand-600 px-5 py-2.5 font-display text-sm font-semibold text-white transition-colors hover:bg-brand-700"
      >
        Aceptar
      </button>
    </div>
  </Container>
</div>

<script>
  const STORAGE_KEY = "esmera-cookie-consent";

  const ALL_GRANTED = {
    analytics_storage:  "granted" as const,
    ad_storage:         "granted" as const,
    ad_user_data:       "granted" as const,
    ad_personalization: "granted" as const,
  };

  const ALL_DENIED = {
    analytics_storage:  "denied" as const,
    ad_storage:         "denied" as const,
    ad_user_data:       "denied" as const,
    ad_personalization: "denied" as const,
  };

  function applyConsent(consent: "granted" | "denied") {
    // gtag('consent', 'update', {...}) — actualiza GTM con los 4 parámetros
    if (typeof (window as any).gtag === "function") {
      (window as any).gtag("consent", "update", consent === "granted" ? ALL_GRANTED : ALL_DENIED);
    }
    // Evento para tags de GTM que usen 'cookie_consent_update' como trigger (ej. Meta Pixel)
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: "cookie_consent_update", consent });
  }

  function initCookieNotice() {
    const notice = document.querySelector<HTMLElement>("[data-cookie-notice]");
    if (!notice || notice.dataset.bound) return;
    notice.dataset.bound = "true";

    const setShift = (px: number) => {
      document.documentElement.style.setProperty("--cookie-notice-shift", `-${px}px`);
    };

    const hide = () => {
      notice.classList.add("translate-y-full");
      setShift(0);
    };

    let saved: string | null = null;
    try { saved = localStorage.getItem(STORAGE_KEY); } catch (e) {}

    if (!saved) {
      requestAnimationFrame(() => {
        notice.classList.remove("translate-y-full");
        setShift(notice.offsetHeight);
      });
    }

    notice.querySelector("[data-cookie-accept]")?.addEventListener("click", () => {
      try { localStorage.setItem(STORAGE_KEY, "granted"); } catch (e) {}
      applyConsent("granted");
      hide();
    });

    notice.querySelector("[data-cookie-reject]")?.addEventListener("click", () => {
      try { localStorage.setItem(STORAGE_KEY, "denied"); } catch (e) {}
      applyConsent("denied");
      hide();
    });
  }

  document.addEventListener("astro:page-load", initCookieNotice);
</script>
