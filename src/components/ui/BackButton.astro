---
interface Props {
  href?: string;
  label?: string;
}
const { href = "/cursos", label = "Volver" } = Astro.props;
---

<a
  data-reveal
  data-back-btn
  data-fallback={href}
  href={href}
  class="group mb-8 inline-flex items-center gap-2.5 rounded-xl border border-brand-200 bg-brand-50/60 px-5 py-2.5 text-sm font-semibold text-brand-700 transition-all duration-200 hover:border-brand-300 hover:bg-brand-100 hover:text-brand-800"
>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-200 group-hover:-translate-x-0.5">
    <path d="M19 12H5M12 5l-7 7 7 7" />
  </svg>
  {label}
</a>

<script>
  function initBackButtons() {
    document.querySelectorAll<HTMLAnchorElement>("[data-back-btn]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const previous = sessionStorage.getItem("previousPage");
        const fallback = btn.dataset.fallback ?? "/cursos";
        window.location.href = previous && previous !== window.location.href
          ? previous
          : fallback;
      });
    });
  }

  initBackButtons();
  document.addEventListener("astro:page-load", initBackButtons);
</script>
