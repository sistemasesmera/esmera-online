---
import Button from "./ui/Button.astro";
import Container from "./ui/Container.astro";
import Icon from "./Icon.astro";
import Search from "./Search.astro";
import { getCollection } from "astro:content";

const allCategories = await getCollection("categories");
const allCourses    = await getCollection("courses");

const topCategories = allCategories
  .filter((c) => !c.data.parent)
  .sort((a, b) => a.data.order - b.data.order);

const courseCountByCategory = new Map<string, number>();
for (const course of allCourses) {
  for (const catRef of course.data.categories) {
    courseCountByCategory.set(catRef.id, (courseCountByCategory.get(catRef.id) ?? 0) + 1);
    const catEntry = allCategories.find((c) => c.id === catRef.id);
    if (catEntry?.data.parent) {
      courseCountByCategory.set(
        catEntry.data.parent,
        (courseCountByCategory.get(catEntry.data.parent) ?? 0) + 1
      );
    }
  }
}

const navLinks = [
  { href: "/",         label: "Inicio" },
  { href: "/blog",     label: "Blog" },
  { href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);

type IconName = "sparkles" | "shield" | "megaphone" | "award" | "users" | "briefcase" | "compass" | "chart" | "target" | "clock" | "bot" | "calendar" | "brush";
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-white/10 bg-gradient-to-r from-brand-800 via-brand-700 to-brand-500 transition-shadow duration-300"
>
  <Container class="flex h-20 items-center justify-between py-4">

    <a href="/" class="inline-flex items-center">
      <img src="/images/esmera-online-logo-blanco.png" alt="Esmera Online" class="h-14 w-auto" />
    </a>

    <nav class="hidden items-center gap-7 lg:flex">

      <!-- Inicio -->
      <a
        href="/"
        aria-current={isActive("/") ? "page" : undefined}
        class:list={[
          "relative text-sm font-semibold transition-colors duration-200 after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-white after:transition-all after:duration-300 hover:text-white hover:after:w-full",
          isActive("/") ? "text-white after:w-full" : "text-white after:w-0",
        ]}
      >
        Inicio
      </a>

      <!-- Cursos (dropdown) -->
      <div class="group relative">
        <button
          class:list={[
            "relative flex cursor-pointer items-center gap-1 text-sm font-semibold transition-colors duration-200 after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-white after:transition-all after:duration-300 hover:text-white group-hover:after:w-[calc(100%-0.85rem)]",
            currentPath.startsWith("/cursos") || currentPath.startsWith("/categorias")
              ? "text-white after:w-[calc(100%-0.85rem)]"
              : "text-white after:w-0",
          ]}
        >
          Cursos
          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" class="text-white/50 transition-transform duration-200 group-hover:rotate-180">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>

        <div class="invisible absolute left-0 top-full w-56 translate-y-2 rounded-xl border border-ink-100 bg-white py-1.5 opacity-0 shadow-xl shadow-ink-900/10 transition-all duration-200 ease-out group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
          {topCategories.map((cat) => (
            <a
              href={`/categorias/${cat.id}`}
              class="block px-4 py-2.5 text-sm text-ink-700 transition-colors duration-150 hover:bg-brand-50 hover:text-ink-900"
            >
              {cat.data.name}
            </a>
          ))}
          <div class="my-1.5 border-t border-ink-100" />
          <a
            href="/cursos"
            class="block px-4 py-2.5 text-sm font-semibold text-brand-700 transition-colors duration-150 hover:bg-brand-50 hover:text-brand-900"
          >
            Ver todos los cursos
          </a>
        </div>
      </div>

      <!-- Resto de links -->
      {navLinks.filter(l => l.href !== "/").map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            "relative text-sm font-semibold transition-colors duration-200 after:absolute after:-bottom-1.5 after:left-0 after:h-px after:bg-white after:transition-all after:duration-300 hover:text-white hover:after:w-full",
            isActive(link.href) ? "text-white after:w-full" : "text-white after:w-0",
          ]}
        >
          {link.label}
        </a>
      ))}

    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <Search />
      <span class="h-6 w-px bg-white/20" aria-hidden="true" />
      <Button href="javascript:void(0)" variant="secondary" class="hover:translate-y-0 hover:bg-white hover:ring-ink-200 active:scale-100" data-lead-modal-trigger>
        Habla con un asesor
      </Button>
    </div>

    <!-- Hamburguesa móvil -->
    <button
      id="mobile-menu-button"
      class="inline-flex h-9 w-9 cursor-pointer flex-col items-center justify-center gap-[5px] rounded-full text-white lg:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Abrir menú</span>
      <span class="h-[2px] w-5 rounded-full bg-current transition-all duration-300" data-menu-bar="top"></span>
      <span class="h-[2px] w-5 rounded-full bg-current transition-all duration-300" data-menu-bar="middle"></span>
      <span class="h-[2px] w-5 rounded-full bg-current transition-all duration-300" data-menu-bar="bottom"></span>
    </button>
  </Container>

  <!-- Menú móvil -->
  <div
    id="mobile-menu"
    class="grid grid-rows-[0fr] overflow-hidden border-t border-transparent bg-white opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-out lg:hidden"
  >
    <div class="overflow-hidden">
      <Container class="flex flex-col gap-1 py-4">

        <!-- Buscador móvil -->
        <div class="relative mb-2">
          <div class="flex items-center gap-2 rounded-xl border border-ink-100 bg-ink-50 px-3.5 py-2.5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-ink-400" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <path d="M21 21l-4.35-4.35" />
            </svg>
            <input
              id="search-input-mobile"
              type="text"
              placeholder="Buscar cursos..."
              autocomplete="off"
              spellcheck="false"
              class="flex-1 bg-transparent text-sm text-ink-700 placeholder-ink-400 outline-none"
            />
          </div>
          <div id="search-results-mobile" class="mt-1.5 hidden overflow-hidden rounded-xl border border-ink-100 bg-white shadow-lg"></div>
        </div>

        <a href="/" class="rounded-lg px-3 py-2 text-sm font-medium text-ink-700 transition-colors duration-150 hover:bg-brand-50" data-mobile-nav-link>Inicio</a>
        <p class="px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-ink-400">Cursos</p>
        {topCategories.map((cat) => (
          <a
            href={`/categorias/${cat.id}`}
            class="rounded-lg px-3 py-2 text-sm font-medium text-ink-700 transition-colors duration-150 hover:bg-brand-50"
            data-mobile-nav-link
          >
            {cat.data.name}
          </a>
        ))}
        <a href="/cursos" class="rounded-lg px-3 py-2 text-sm font-medium text-brand-700 transition-colors duration-150 hover:bg-brand-50" data-mobile-nav-link>Ver todos los cursos</a>
        <div class="my-2 h-px bg-ink-100" />
        {navLinks.filter(l => l.href !== "/").map((link) => (
          <a href={link.href} class="rounded-lg px-3 py-2 text-sm font-medium text-ink-700 transition-colors duration-150 hover:bg-brand-50" data-mobile-nav-link>
            {link.label}
          </a>
        ))}
        <Button href="javascript:void(0)" variant="primary" class="mt-3 w-full" data-lead-modal-trigger>
          Habla con un asesor
        </Button>
      </Container>
    </div>
  </div>
</header>

<script>
  let menuAbort: AbortController | null = null;

  function initMobileMenu() {
    menuAbort?.abort();
    menuAbort = new AbortController();
    const { signal } = menuAbort;

    const header = document.getElementById("site-header");
    const button = document.getElementById("mobile-menu-button");
    const menu   = document.getElementById("mobile-menu");
    const bars   = button?.querySelectorAll<HTMLSpanElement>("[data-menu-bar]");

    function setMenuOpen(open: boolean) {
      if (!button || !menu) return;
      button.setAttribute("aria-expanded", String(open));
      menu.classList.toggle("grid-rows-[0fr]",  !open);
      menu.classList.toggle("opacity-0",         !open);
      menu.classList.toggle("grid-rows-[1fr]",   open);
      menu.classList.toggle("opacity-100",        open);
      menu.classList.toggle("border-ink-100",     open);
      menu.classList.toggle("border-transparent", !open);

      bars?.forEach((bar) => {
        const role = bar.dataset.menuBar;
        if (open) {
          if (role === "top")    bar.style.transform = "translateY(7px) rotate(45deg)";
          if (role === "middle") bar.style.opacity   = "0";
          if (role === "bottom") bar.style.transform = "translateY(-7px) rotate(-45deg)";
        } else {
          bar.style.transform = "";
          bar.style.opacity   = "1";
        }
      });
    }

    button?.addEventListener("click", () => {
      setMenuOpen(button.getAttribute("aria-expanded") !== "true");
    }, { signal });

    menu?.querySelectorAll<HTMLAnchorElement>("[data-mobile-nav-link]").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false), { signal });
    });

    function updateHeaderShadow() {
      if (!header) return;
      const scrolled = window.scrollY > 8;
      header.classList.toggle("shadow-md",           scrolled);
      header.classList.toggle("shadow-brand-900/30", scrolled);
    }

    window.addEventListener("scroll", updateHeaderShadow, { passive: true, signal });
    updateHeaderShadow();
  }

  initMobileMenu();
  document.addEventListener("astro:page-load", initMobileMenu);
</script>
