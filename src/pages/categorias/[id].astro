---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/ui/Container.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import CourseCard from "../../components/CourseCard.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const categories = await getCollection("categories");
  const courses = await getCollection("courses");

  return categories.map((category) => {
    const children = categories.filter((c) => c.data.parent === category.id).sort((a, b) => a.data.order - b.data.order);
    const childIds = new Set(children.map((c) => c.id));

    const directCourses = courses.filter((course) =>
      course.data.categories.some((c) => c.id === category.id)
    ).sort((a, b) => a.data.order - b.data.order);

    const childCourses = courses.filter((course) =>
      course.data.categories.some((c) => childIds.has(c.id))
    ).sort((a, b) => a.data.order - b.data.order);

    const allCourses = children.length > 0 ? childCourses : directCourses;

    return {
      params: { id: category.id },
      props: { category, children, courses: allCourses },
    };
  });
}) satisfies GetStaticPaths;

const { category, children, courses } = Astro.props;

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Cursos", item: new URL("/cursos", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: category.data.name, item: new URL(`/categorias/${category.id}`, Astro.site).toString() },
  ],
};
---

<Layout title={category.data.name} description={category.data.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <section class="relative overflow-hidden border-b border-ink-100 bg-gradient-to-b from-brand-50 to-white py-16 sm:py-20">
    <div class="absolute inset-x-0 top-0 -z-10 h-full bg-dot-grid-light opacity-60 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"></div>
    <Container class="relative">
      <div data-reveal>
        <Eyebrow>Categoría</Eyebrow>
        <h1 class="mt-4 font-display text-4xl font-semibold text-ink-900 sm:text-5xl">{category.data.name}</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-500">{category.data.description}</p>
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      {children.length > 0 && (
        <div class="mb-8 flex flex-wrap gap-2">
          <button
            data-filter="all"
            class="filter-btn rounded-full border border-brand-500 bg-brand-500 px-4 py-1.5 font-mono text-xs font-semibold text-white transition-colors"
          >
            Todos
          </button>
          {children.map((child) => (
            <button
              data-filter={child.id}
              class="filter-btn rounded-full border border-ink-200 bg-white px-4 py-1.5 font-mono text-xs font-semibold text-ink-600 transition-colors hover:border-brand-400 hover:text-brand-600"
            >
              {child.data.name}
            </button>
          ))}
        </div>
      )}

      {courses.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {courses.map((course, index) => {
            const subcat = course.data.categories[0]?.id ?? "";
            return (
              <div
                data-reveal
                data-course-filter={subcat}
                style={`--reveal-delay: ${(index % 3) * 80}ms`}
              >
                <CourseCard course={course} />
              </div>
            );
          })}
        </div>
      ) : (
        <p data-reveal class="text-ink-500">Próximamente nuevos cursos en esta categoría.</p>
      )}
    </Container>
  </section>
</Layout>

<script>
  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
    const cards = document.querySelectorAll<HTMLElement>("[data-course-filter]");
    if (!buttons.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter!;

        buttons.forEach((b) => {
          b.classList.remove("bg-brand-500", "border-brand-500", "text-white");
          b.classList.add("bg-white", "border-ink-200", "text-ink-600");
        });
        btn.classList.add("bg-brand-500", "border-brand-500", "text-white");
        btn.classList.remove("bg-white", "border-ink-200", "text-ink-600");

        cards.forEach((card) => {
          const match = filter === "all" || card.dataset.courseFilter === filter;
          card.style.display = match ? "" : "none";
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initFilters);
</script>
