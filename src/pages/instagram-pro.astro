---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CookieNotice from "../components/CookieNotice.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Curso Instagram Pro — Aprende, crea y gestiona una marca en Instagram | Esmera Online</title>
    <meta name="description" content="Instagram + Canva + Community Manager en una única formación. 90 horas online con tutor, certificado incluido. Tu futuro puede empezar en Instagram." />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content="Curso Instagram Pro — Esmera Online" />
    <meta property="og:description" content="Aprende a crear, diseñar, publicar y gestionar Instagram como un profesional. Formación completa en 90 horas." />
    <!-- Consent Mode v2 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var _consent = localStorage.getItem('esmera-cookie-consent');
      gtag('consent', 'default', {
        analytics_storage:     _consent === 'granted' ? 'granted' : 'denied',
        ad_storage:            'denied',
        ad_user_data:          'denied',
        ad_personalization:    'denied',
        wait_for_update:       500,
      });
    </script>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-N9BWQC3S');</script>
    <!-- End Google Tag Manager -->
    <ClientRouter />
    <script>
      import "../lib/reveal";
    </script>

    <style is:global>
      :root {
        --ig: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc2a8d 100%);
        --ig-text: linear-gradient(90deg, #f09433 0%, #e6683c 20%, #dc2743 45%, #cc2366 75%, #bc2a8d 100%);
      }

      .ig-btn {
        background: var(--ig);
        color: #fff;
        font-weight: 700;
        border-radius: 0.75rem;
        padding: 1rem 2rem;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        transition: transform 0.2s, box-shadow 0.2s;
        box-shadow: 0 4px 24px rgba(220,39,67,0.25);
      }
      .ig-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(220,39,67,0.35); }

      .ig-text {
        background: var(--ig-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 1.25rem;
      }

      .stat-num {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.03em;
      }

      /* FAQ accordion */
      .faq-item summary { list-style: none; cursor: pointer; }
      .faq-item summary::-webkit-details-marker { display: none; }
      .faq-item[open] .faq-icon { transform: rotate(45deg); }
      .faq-icon { transition: transform 0.25s; }

      /* intl-tel-input */
      .iti { width: 100%; }
      .iti__selected-flag { border-radius: 0.75rem 0 0 0.75rem; padding-inline: 0.75rem; }
      .iti__country-list {
        z-index: 9999;
        background: #ffffff !important;
        color: #111827 !important;
        border: 1px solid #e5e7eb !important;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
      }
      .iti__country-list .iti__country-name,
      .iti__country-list .iti__dial-code { color: #111827 !important; }
      .iti__country-list .iti__country.iti__highlight,
      .iti__country-list .iti__country:hover { background: #f9fafb !important; }
      .iti__search-input {
        color: #111827 !important;
        background: #f9fafb !important;
        border-color: #e5e7eb !important;
      }

      /* WhatsApp floating button */
      .wa-float {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 50;
        display: flex;
        align-items: center;
        gap: 0.625rem;
        background: #25d366;
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        padding: 0.75rem 1.25rem;
        border-radius: 9999px;
        box-shadow: 0 4px 20px rgba(37,211,102,0.4);
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none;
      }
      .wa-float:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(37,211,102,0.5); }
      @media (max-width: 480px) {
        .wa-float span { display: none; }
        .wa-float { padding: 0.875rem; }
      }
    </style>
  </head>

  <body class="bg-white text-ink-900 antialiased">
    <!-- GTM noscript -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N9BWQC3S" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- HEADER -->
    <header class="sticky top-0 z-20 border-b border-ink-100 bg-white/95 backdrop-blur-sm">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3.5">
        <img src="/esmeraonline-logo.png" alt="Esmera Online" class="h-14 w-auto" />
        <a href="tel:+34661043572"
          class="flex items-center gap-2 rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-medium text-ink-700 transition hover:border-ink-300 hover:text-ink-900">
          <svg class="h-3.5 w-3.5 text-ink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          661 043 572
        </a>
      </div>
    </header>

    <main>

      <!-- ① HERO -->
      <!-- En móvil solo el titular, el resto aparece tras el vídeo -->
      <section class="relative overflow-hidden px-5 pb-4 pt-10 sm:pb-16 sm:pt-28">
        <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[500px]" style="background: linear-gradient(180deg, rgba(240,148,51,0.05) 0%, rgba(188,42,141,0.03) 60%, transparent 100%)"></div>
        <div class="pointer-events-none absolute inset-0 -z-10 bg-dot-grid-light opacity-40 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"></div>

        <div class="mx-auto max-w-4xl text-center">
          <h1 class="font-display text-3xl font-black leading-[1.08] tracking-tight text-ink-900 sm:text-6xl lg:text-7xl">
            Convierte Instagram<br />
            <span class="ig-text">en tu profesión.</span>
          </h1>

          <!-- Oculto en móvil, visible en desktop -->
          <p class="mx-auto mt-6 hidden max-w-2xl text-lg leading-relaxed text-ink-500 sm:block sm:text-xl">
            90 horas de formación en Instagram, Canva y Community Manager.
            Aprende de cero, trabaja desde el primer día.
          </p>

          <div class="mt-8 hidden flex-col items-center gap-4 sm:flex sm:flex-row sm:justify-center">
            <a href="#form" class="ig-btn text-base">
              Quiero información
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a href="tel:+34661043572"
              class="inline-flex items-center gap-2 rounded-xl border border-ink-200 bg-white px-7 py-4 text-base font-medium text-ink-700 transition hover:border-ink-300 hover:text-ink-900">
              <svg class="h-4 w-4 text-ink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              Llámanos
            </a>
          </div>

          <div class="mt-6 hidden flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-ink-400 sm:flex">
            <span>Sin compromiso</span>
            <span>·</span>
            <span>Un asesor te llama en &lt;24 h</span>
            <span>·</span>
            <span>Certificado incluido</span>
          </div>
        </div>
      </section>

      <!-- ② VIDEO -->
      <section class="px-5 pb-10 pt-4 sm:py-20">
        <div class="mx-auto max-w-3xl">
          <p class="mb-3 text-center text-xs font-semibold uppercase tracking-[0.2em] text-ink-400">Mira esto antes de decidir</p>
          <h2 class="mb-6 hidden text-center font-display text-2xl font-bold text-ink-900 sm:mb-10 sm:block sm:text-3xl">
            Todo lo que necesitas saber<br class="hidden sm:block" />
            <span class="ig-text">en menos de 5 minutos</span>
          </h2>

          <!--
            PARA ACTIVAR EL VIDEO DE WISTIA:
            1. Reemplaza WISTIA_VIDEO_ID por el ID real de tu vídeo en Wistia.
            2. Elimina el bloque "placeholder" y descomenta el bloque de abajo.

            <script src="https://fast.wistia.com/assets/external/E-v1.js" async></script>
            <div class="overflow-hidden rounded-2xl shadow-xl shadow-ink-900/10" style="padding:56.25% 0 0 0;position:relative;">
              <div style="height:100%;left:0;position:absolute;top:0;width:100%;">
                <div class="wistia_embed wistia_async_WISTIA_VIDEO_ID videoFoam=true" style="height:100%;position:relative;width:100%;">&nbsp;</div>
              </div>
            </div>
          -->

          <!-- Placeholder hasta tener el vídeo -->
          <div class="card relative overflow-hidden shadow-xl shadow-ink-900/5" style="aspect-ratio:16/9; background:#f3f4f6;">
            <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 60%, rgba(220,39,67,0.07) 0%, transparent 70%);"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center gap-5">
              <div class="flex h-20 w-20 items-center justify-center rounded-full border border-ink-200 bg-white shadow-sm">
                <svg class="h-9 w-9 translate-x-0.5 text-ink-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <div class="text-center">
                <p class="font-display text-lg font-bold text-ink-700">Vídeo próximamente</p>
                <p class="mt-1 text-sm text-ink-400">Espacio reservado para el vídeo de Wistia</p>
              </div>
            </div>
          </div>

          <!-- En móvil: subtítulo y CTAs aparecen tras el vídeo -->
          <div class="mt-6 sm:hidden">
            <p class="mb-6 text-center text-base leading-relaxed text-ink-500">
              90 horas de formación en Instagram, Canva y Community Manager.
              Aprende de cero, trabaja desde el primer día.
            </p>
            <div class="flex flex-col gap-3">
              <a href="#form" class="ig-btn justify-center text-base">
                Quiero información
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <a href="tel:+34661043572"
                class="inline-flex items-center justify-center gap-2 rounded-xl border border-ink-200 bg-white px-7 py-4 text-base font-medium text-ink-700">
                <svg class="h-4 w-4 text-ink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
                Llámanos
              </a>
            </div>
            <div class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-ink-400">
              <span>Sin compromiso</span>
              <span>·</span>
              <span>Asesor en &lt;24 h</span>
              <span>·</span>
              <span>Certificado incluido</span>
            </div>
          </div>

          <!-- En desktop: CTA simple tras el vídeo -->
          <div class="mt-10 hidden text-center sm:block">
            <a href="#form" class="ig-btn">
              Quiero información
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- ② STATS BAR -->
      <section class="border-y border-ink-100 bg-ink-50 px-5 py-10">
        <div class="mx-auto grid max-w-4xl grid-cols-3 gap-8 text-center">
          <div>
            <p class="stat-num ig-text">90</p>
            <p class="mt-1 text-sm text-ink-500">horas de formación</p>
          </div>
          <div>
            <p class="stat-num ig-text">3</p>
            <p class="mt-1 text-sm text-ink-500">cursos en uno</p>
          </div>
          <div>
            <p class="stat-num ig-text">100%</p>
            <p class="mt-1 text-sm text-ink-500">online y a tu ritmo</p>
          </div>
        </div>
      </section>

      <!-- ④ QUÉ INCLUYE -->
      <section class="border-t border-ink-100 bg-ink-50 px-5 py-20">
        <div class="mx-auto max-w-5xl">
          <div class="mb-14 text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-ink-400">Qué incluye</p>
            <h2 class="font-display text-3xl font-bold text-ink-900 sm:text-4xl">
              3 cursos. <span class="ig-text">Una formación completa.</span>
            </h2>
            <p class="mt-3 text-ink-500">Todo lo que necesitas para gestionar y potenciar una marca en Instagram.</p>
          </div>

          <div class="grid gap-5 sm:grid-cols-3">
            <!-- Instagram -->
            <div class="card p-8 shadow-sm">
              <div class="mb-6 flex items-center justify-between">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl" style="background:rgba(220,39,67,0.08);">
                  <svg class="h-6 w-6" style="color:#dc2743" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                  </svg>
                </div>
                <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-500">20 h</span>
              </div>
              <h3 class="mb-3 font-display text-xl font-bold text-ink-900">Instagram</h3>
              <p class="text-sm leading-relaxed text-ink-500">
                Algoritmo, Reels, Stories y contenido que crece. Aprende a gestionar un perfil desde cero y convertirlo en una herramienta de negocio real.
              </p>
            </div>

            <!-- Canva -->
            <div class="card p-8 shadow-sm">
              <div class="mb-6 flex items-center justify-between">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl" style="background:rgba(204,35,102,0.08);">
                  <svg class="h-6 w-6" style="color:#cc2366" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="4"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h8M12 8v8"/>
                  </svg>
                </div>
                <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-500">30 h</span>
              </div>
              <h3 class="mb-3 font-display text-xl font-bold text-ink-900">Canva</h3>
              <p class="text-sm leading-relaxed text-ink-500">
                Diseña piezas para feed, Stories, Reels y anuncios como un profesional. Sin conocimientos previos de diseño. Plantillas, tipografía y marca personal.
              </p>
            </div>

            <!-- Community Manager -->
            <div class="card p-8 shadow-sm">
              <div class="mb-6 flex items-center justify-between">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl" style="background:rgba(188,42,141,0.08);">
                  <svg class="h-6 w-6" style="color:#bc2a8d" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                  </svg>
                </div>
                <span class="rounded-full bg-ink-100 px-3 py-1 text-xs font-semibold text-ink-500">40 h</span>
              </div>
              <h3 class="mb-3 font-display text-xl font-bold text-ink-900">Community Manager</h3>
              <p class="text-sm leading-relaxed text-ink-500">
                Estrategia, planificación, métricas y gestión de comunidades. Conviértete en el perfil que los negocios buscan contratar.
              </p>
            </div>
          </div>

          <div class="mt-10 text-center">
            <a href="#form" class="ig-btn">
              Quiero información
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- ⑤ PARA QUIÉN ES -->
      <section class="border-t border-ink-100 px-5 py-20">
        <div class="mx-auto max-w-3xl">
          <div class="mb-12 text-center">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-ink-400">¿Es para ti?</p>
            <h2 class="font-display text-3xl font-bold text-ink-900 sm:text-4xl">
              Este curso es para ti si…
            </h2>
          </div>
          <div class="space-y-3">
            {[
              "Quieres trabajar desde casa gestionando redes sociales para negocios.",
              "Tienes un negocio propio y quieres llevar tú mismo tu Instagram.",
              "Buscas una salida laboral real sin necesitar un título universitario.",
              "Ya publicas en Instagram pero no ves resultados y no sabes por qué.",
              "Quieres aprender diseño sin complicarte con herramientas difíciles.",
            ].map((item) => (
              <div class="card flex items-start gap-4 p-5 shadow-sm">
