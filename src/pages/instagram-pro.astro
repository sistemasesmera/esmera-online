---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CookieNotice from "../components/CookieNotice.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Curso Instagram Pro — Aprende, crea y gestiona una marca en Instagram | Esmera Online</title>
    <meta name="description" content="Instagram + Canva + Community Manager en una única formación. 90 horas online con tutor, certificado incluido. Tu futuro puede empezar en Instagram." />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content="Curso Instagram Pro — Esmera Online" />
    <meta property="og:description" content="Aprende a crear, diseñar, publicar y gestionar Instagram como un profesional. Formación completa en 90 horas." />
    <ClientRouter />
    <script>
      import "../lib/reveal";
    </script>
    <script is:inline>
      function loadEsmeraWidget() {
        const old = document.getElementById("esmera-widget-script");
        if (old) old.remove();
        const s = document.createElement("script");
        s.id = "esmera-widget-script";
        s.src = "https://app.esmeraonline.com/api/widget.js";
        document.head.appendChild(s);
      }
      loadEsmeraWidget();
      document.addEventListener("astro:page-load", loadEsmeraWidget);
    </script>
  </head>

  <body class="bg-white text-ink-900 antialiased">

    <!-- Top bar -->
    <header class="sticky top-0 z-20 border-b border-ink-100 bg-white/95 backdrop-blur-sm">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
        <img src="/esmeraonline-logo.png" alt="Esmera Online" class="h-16 w-auto" />
        <a
          href="tel:+34661043572"
          class="flex items-center gap-2 rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-medium text-ink-700 transition-colors hover:border-ink-300 hover:text-ink-900"
        >
          <svg class="h-3.5 w-3.5 text-ink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          661 043 572
        </a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="relative overflow-hidden px-4 pb-14 pt-14 sm:px-6 sm:pb-20 sm:pt-20">
        <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[420px]" style="background: linear-gradient(180deg, rgba(240,148,51,0.06) 0%, rgba(188,42,141,0.04) 60%, transparent 100%)"></div>
        <div class="pointer-events-none absolute inset-0 -z-10 bg-dot-grid-light opacity-50 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"></div>

        <!-- Badge -->
        <div class="mb-6 flex justify-center">
          <span class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white" style="background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc2a8d 100%);">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            Curso Instagram Pro
          </span>
        </div>

        <div class="mx-auto max-w-4xl text-center">
          <h1 class="font-display text-4xl font-black leading-tight tracking-tight text-ink-900 sm:text-5xl lg:text-6xl xl:text-7xl">
            Tu futuro puede
            <span class="mt-1 block" style="background: linear-gradient(90deg, #f09433 0%, #e6683c 20%, #dc2743 40%, #cc2366 70%, #bc2a8d 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
              empezar en Instagram
            </span>
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-500 sm:text-xl">
            Aprende, crea, gestiona y conviértelo en una oportunidad real. Instagram + Canva + Community Manager en una única formación de <strong class="text-ink-800">90 horas</strong>.
          </p>


          <!-- Primary CTA -->
          <div class="mt-8">
            <a href="#form" class="inline-flex items-center gap-2 rounded-xl px-7 py-3.5 font-display text-sm font-bold text-white shadow-lg transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl" style="background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc2a8d 100%)">
              Quiero saber más
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- Hook section -->
      <section class="border-y border-ink-100 bg-ink-50 px-4 py-12 sm:px-6">
        <div class="mx-auto max-w-3xl text-center">
          <p class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">
            Un cliente no necesita solo posts.
          </p>
          <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-ink-500">
            Necesita alguien que sepa <strong class="text-ink-800">crear, diseñar, publicar y gestionar</strong> su Instagram. Con este curso, ese alguien eres tú.
          </p>
        </div>
      </section>

      <!-- 3 courses -->
      <section class="px-4 py-16 sm:px-6 sm:py-20">
        <div class="mx-auto max-w-6xl">
          <div class="mb-12 text-center">
            <p class="font-mono text-xs font-semibold uppercase tracking-[0.2em] text-ink-400">Qué incluye</p>
            <h2 class="mt-3 font-display text-3xl font-bold text-ink-900 sm:text-4xl">3 cursos. Una formación completa.</h2>
            <p class="mt-3 text-ink-500">Todo lo que necesitas para gestionar y potenciar una marca en Instagram.</p>
          </div>

          <div class="grid gap-6 sm:grid-cols-3">
            <!-- Instagram -->
            <div class="relative overflow-hidden rounded-2xl border border-ink-100 bg-white p-8 shadow-sm">
              <div class="absolute inset-x-0 top-0 h-1" style="background: linear-gradient(90deg, #f09433, #dc2743)"></div>
              <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl" style="background: linear-gradient(135deg, rgba(240,148,51,0.1), rgba(220,39,67,0.1))">
                <svg class="h-7 w-7" style="color: #dc2743" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div class="mb-3 flex items-center justify-between">
                <h3 class="font-display text-xl font-bold text-ink-900">Instagram</h3>
                <span class="rounded-full bg-ink-50 px-3 py-1 font-mono text-xs font-semibold text-ink-500">20 horas</span>
              </div>
              <p class="text-sm leading-relaxed text-ink-500">
                Domina la plataforma: algoritmo, contenido, Reels, Stories e historias. Aprende a crear publicaciones que conectan y hacen crecer un perfil de cero.
              </p>
            </div>

            <!-- Canva -->
            <div class="relative overflow-hidden rounded-2xl border border-ink-100 bg-white p-8 shadow-sm">
              <div class="absolute inset-x-0 top-0 h-1" style="background: linear-gradient(90deg, #dc2743, #cc2366)"></div>
              <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl" style="background: linear-gradient(135deg, rgba(220,39,67,0.1), rgba(204,35,102,0.1))">
                <!-- Canva logo simplified -->
                <svg class="h-7 w-7" style="color: #cc2366" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="4"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h8M12 8v8"/>
                </svg>
              </div>
              <div class="mb-3 flex items-center justify-between">
                <h3 class="font-display text-xl font-bold text-ink-900">Canva</h3>
                <span class="rounded-full bg-ink-50 px-3 py-1 font-mono text-xs font-semibold text-ink-500">30 horas</span>
              </div>
              <p class="text-sm leading-relaxed text-ink-500">
                Diseña como un profesional, fácil y rápido. Crea piezas visuales para feed, Stories, Reels y anuncios que destacan sin necesitar conocimientos previos de diseño.
              </p>
            </div>

            <!-- Community Manager -->
            <div class="relative overflow-hidden rounded-2xl border border-ink-100 bg-white p-8 shadow-sm">
              <div class="absolute inset-x-0 top-0 h-1" style="background: linear-gradient(90deg, #cc2366, #bc2a8d)"></div>
              <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl" style="background: linear-gradient(135deg, rgba(204,35,102,0.1), rgba(188,42,141,0.1))">
                <svg class="h-7 w-7" style="color: #bc2a8d" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z" />
                </svg>
              </div>
              <div class="mb-3 flex items-center justify-between">
                <h3 class="font-display text-xl font-bold text-ink-900">Community Manager</h3>
                <span class="rounded-full bg-ink-50 px-3 py-1 font-mono text-xs font-semibold text-ink-500">40 horas</span>
              </div>
              <p class="text-sm leading-relaxed text-ink-500">
                Gestiona comunidades y haz crecer marcas. Estrategia, planificación de contenido, métricas, atención a la comunidad y cómo convertirte en el CM que los negocios buscan.
              </p>
            </div>
          </div>

          <!-- Total hours badge -->
          <div class="mt-8 flex justify-center">
            <div class="inline-flex items-center gap-3 rounded-2xl border border-ink-100 bg-ink-50 px-6 py-4">
              <svg class="h-5 w-5 text-ink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              <span class="font-display text-base font-semibold text-ink-900">90 horas de formación completa</span>
              <span class="text-ink-400">·</span>
              <span class="text-sm text-ink-500">100% online · a tu ritmo</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Benefits -->
      <section class="px-4 py-14 sm:px-6">
        <div class="mx-auto max-w-6xl">
          <div class="overflow-hidden rounded-3xl p-8 sm:p-10" style="background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc2a8d 100%);">
            <div class="mb-8 text-center">
              <h2 class="font-display text-2xl font-bold text-white sm:text-3xl">Todo incluido desde el primer día</h2>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {[
                { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />`, label: "Acceso 24/7", sub: "Estudia a tu ritmo, cuando puedas" },
                { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />`, label: "Tutor específico", sub: "Resuelve tus dudas con un experto" },
                { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />`, label: "Materiales descargables", sub: "Plantillas y recursos para aplicar ya" },
                { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.990" />`, label: "Actualizaciones incluidas", sub: "Contenido siempre al día" },
                { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 3.741-3.342M6.75 15a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm0 0v-3.675A55.378 55.378 0 0 1 12 8.443m-7.007 11.55A5.981 5.981 0 0 0 6.75 15.75v-1.5" />`, label: "Certificado de finalización", sub: "Acredita tu formación ante cualquier empresa" },
                { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 8.25h3m-3 0a.75.75 0 0 1-.75-.75V6a.75.75 0 0 1 .75-.75h3a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-.75.75m-3 0h3" />`, label: "100% online", sub: "Sin desplazamientos ni horarios fijos" },
              ].map((b) => (
                <div class="flex items-start gap-3 rounded-xl bg-white/10 p-4">
                  <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/20">
                    <svg class="h-4.5 w-4.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" set:html={b.icon} />
                  </div>
                  <div>
                    <p class="font-display text-sm font-semibold text-white">{b.label}</p>
                    <p class="mt-0.5 text-xs text-white/70">{b.sub}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Lead Form -->
      <section id="form" class="px-4 pb-24 pt-16 sm:px-6">
        <div class="mx-auto max-w-lg">
          <div class="mb-8 text-center">
            <h2 class="font-display text-3xl font-bold text-ink-900 sm:text-4xl">
              Quiero saber más
              <span class="block text-2xl font-semibold" style="background: linear-gradient(90deg, #f09433, #bc2a8d); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
                sobre el Curso Instagram Pro
              </span>
            </h2>
            <p class="mt-3 text-sm text-ink-400">Un asesor te contacta en menos de 24 h. Sin compromiso.</p>
          </div>

          <div class="relative overflow-hidden rounded-3xl border border-ink-100 bg-white p-8 shadow-xl shadow-ink-900/5 sm:p-10">
            <div class="absolute inset-x-0 top-0 h-[3px]" style="background: linear-gradient(90deg, #f09433 0%, #dc2743 50%, #bc2a8d 100%)"></div>

            <div id="ip-form-success" class="hidden flex-col items-center gap-4 py-8 text-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-full" style="background: linear-gradient(135deg, rgba(240,148,51,0.15), rgba(188,42,141,0.15))">
                <svg class="h-8 w-8" style="color: #dc2743" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </span>
              <div>
                <p class="font-display text-lg font-semibold text-ink-900">¡Recibido!</p>
                <p class="mt-1 text-sm text-ink-500">Un asesor se pondrá en contacto contigo muy pronto.</p>
              </div>
            </div>

            <div id="ip-form-duplicate" class="hidden flex-col items-center gap-4 py-8 text-center">
              <span class="flex h-16 w-16 items-center justify-center rounded-full bg-ink-50">
                <svg class="h-8 w-8 text-ink-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
              </span>
              <p class="text-sm text-ink-500">Ya tenemos tu solicitud. En breve te contactamos.</p>
            </div>

            <form id="ip-lead-form" class="space-y-4" novalidate>
              <input type="hidden" name="courseOfInterest" value="LANDING - INSTAGRAM PRO" />

              <div>
                <label for="ip-name" class="mb-1.5 block font-mono text-xs font-medium uppercase tracking-wide text-ink-500">Nombre completo</label>
                <input id="ip-name" name="name" type="text" required placeholder="Tu nombre"
                  class="w-full rounded-xl border border-ink-200 px-4 py-3 text-sm text-ink-900 placeholder-ink-300 outline-none transition-colors focus:border-[#dc2743] focus:ring-2 focus:ring-[#dc2743]/10" />
              </div>

              <div>
                <label for="ip-phone" class="mb-1.5 block font-mono text-xs font-medium uppercase tracking-wide text-ink-500">Teléfono</label>
                <input id="ip-phone" name="phone" type="tel" required placeholder="612 345 678"
                  class="w-full rounded-xl border border-ink-200 px-4 py-3 text-sm text-ink-900 placeholder-ink-300 outline-none transition-colors focus:border-[#dc2743] focus:ring-2 focus:ring-[#dc2743]/10" />
