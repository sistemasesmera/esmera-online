<script>
  import intlTelInput from "intl-tel-input/intlTelInputWithUtils";
  import "intl-tel-input/styles";
  import { submitLead } from "../lib/leads";

  function initInstagramProForm() {
    const form = document.getElementById("ip-lead-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "true";

    const phoneInput = form.querySelector<HTMLInputElement>("#ip-phone");
    const phoneError = form.querySelector<HTMLParagraphElement>("#ip-phone-error");
    const successPanel = document.getElementById("ip-form-success");
    const duplicatePanel = document.getElementById("ip-form-duplicate");
    const status = document.getElementById("ip-form-status");
    const submitBtn = form.querySelector<HTMLButtonElement>("button[type=submit]");

    const iti = phoneInput
      // @ts-expect-error dropdownContainer valid at runtime
      ? intlTelInput(phoneInput, { initialCountry: "es", dropdownContainer: document.body })
      : null;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);

      try {
        if (iti && !iti.isValidNumber()) {
          phoneError?.classList.remove("hidden");
          phoneInput?.focus();
          return;
        }
      } catch { /* leave server to validate */ }
      phoneError?.classList.add("hidden");

      if (submitBtn) submitBtn.disabled = true;
      if (status) status.textContent = "Enviando...";

      const result = await submitLead({
        name: String(data.get("name") ?? ""),
        email: String(data.get("email") ?? "") || undefined,
        phone: iti ? iti.getNumber() : String(data.get("phone") ?? ""),
        courseOfInterest: "LANDING - INSTAGRAM PRO",
        message: undefined,
      });

      if (result.ok) {
        form.reset();
        form.classList.add("hidden");
        successPanel?.classList.remove("hidden");
        successPanel?.classList.add("flex");
      } else if (result.duplicate) {
        form.reset();
        form.classList.add("hidden");
        duplicatePanel?.classList.remove("hidden");
        duplicatePanel?.classList.add("flex");
      } else {
        if (status) status.textContent = "Ha ocurrido un error. Inténtalo de nuevo o llámanos.";
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  document.addEventListener("astro:page-load", initInstagramProForm);
</script>

