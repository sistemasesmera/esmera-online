---
import LayoutLP from "../../layouts/LayoutLP.astro";
import LpLeadForm from "../../components/LpLeadForm.astro";
import Icon from "../../components/Icon.astro";
import { Image } from "astro:assets";
import unasImg from "../../content/courses/unas.png";

const COURSE_NAME  = "Curso Profesional de Uñas Esmera";
const PRICE        = 660;
const PRICE_LIVE   = 1199;
const WA_PHONE     = "34661043572";
const WA_MSG       = encodeURIComponent("¡Hola! Me interesa el Curso Profesional de Uñas Esmera. ¿Podéis darme más información?");
const WA_URL       = `https://wa.me/${WA_PHONE}?text=${WA_MSG}`;

const features = ["100% online", "A tu ritmo", "Tutor incluido", "Diploma acreditado"] as const;

const objectives = [
  "Dominar las técnicas de uñas acrílicas, gel y semipermanente.",
  "Aplicar diseños de nail art creativos y técnicas decorativas avanzadas.",
  "Gestionar la higiene, esterilización y seguridad en el puesto de trabajo.",
  "Atender al cliente con profesionalidad y fidelizarlo en tu negocio.",
];

const audience = [
  {
    icon: "compass" as const,
    title: "Empiezas desde cero",
    desc: "No necesitas experiencia previa. Empezamos desde las bases y avanzamos paso a paso.",
  },
  {
    icon: "briefcase" as const,
    title: "Quieres trabajar por tu cuenta",
    desc: "Monta tu propio negocio o ejerce como profesional autónoma con formación sólida.",
  },
  {
    icon: "award" as const,
    title: "Quieres profesionalizarte",
    desc: "Ya conoces las bases y buscas una formación rigurosa para destacar en el sector.",
  },
];

// TODO: Rellenar con los módulos reales del temario del curso
const temario = [
  "[PENDIENTE: Módulo 1 — escribe aquí el título y descripción del módulo]",
  "[PENDIENTE: Módulo 2 — escribe aquí el título y descripción del módulo]",
  "[PENDIENTE: Módulo 3 — escribe aquí el título y descripción del módulo]",
  "[PENDIENTE: Módulo 4 — escribe aquí el título y descripción del módulo]",
  "[PENDIENTE: Módulo 5 — escribe aquí el título y descripción del módulo]",
  "[PENDIENTE: Módulo 6 — escribe aquí el título y descripción del módulo]",
  "[PENDIENTE: Módulo 7 — escribe aquí el título y descripción del módulo]",
  "[PENDIENTE: Módulo 8 — escribe aquí el título y descripción del módulo]",
];

const howItWorks = [
  { num: "01", icon: "clock" as const,    title: "Acceso inmediato",       desc: "Desde el primer día accedes a todos los contenidos sin esperas." },
  { num: "02", icon: "chat" as const,     title: "Tutor asignado",         desc: "Un tutor personal te acompaña durante todo el curso." },
  { num: "03", icon: "users" as const,    title: "Tutorías en plataforma", desc: "Comunícate con tu tutor cuando lo necesites, sin límite." },
  { num: "04", icon: "target" as const,   title: "Evaluaciones prácticas", desc: "Ejercicios y evaluaciones que consolidan tu aprendizaje real." },
  { num: "05", icon: "award" as const,    title: "Certificado al terminar", desc: "Diploma privado de Esmera Online al superar el curso." },
];

// TODO: Rellenar con las preguntas y respuestas reales sobre financiación y kit de materiales
const faqs = [
  {
    q: "¿Necesito experiencia previa para hacer este curso?",
    a: "No, el curso está diseñado desde cero. Empezamos por las bases y vamos avanzando paso a paso hasta las técnicas más demandadas.",
  },
  {
    q: "¿Tendré un tutor asignado?",
    a: "Sí, contarás con un tutor personal durante todo el curso para resolver tus dudas y guiarte en tu aprendizaje.",
  },
  {
    q: "¿Cuánto tiempo tengo para completar el curso?",
    a: "Tienes acceso flexible para organizarte a tu ritmo, sin fechas límite estrictas. Puedes empezar cuando quieras.",
  },
  {
    q: "¿El diploma tiene validez profesional?",
    a: "Recibirás un diploma privado de Esmera Online que acredita tu formación como técnica de uñas profesional.",
  },
  {
    q: "¿Podré trabajar como técnica de uñas al terminar?",
    a: "Sí, el programa está orientado a la empleabilidad real. Al finalizar tendrás los conocimientos y la práctica necesarios para ejercer de forma profesional.",
  },
  {
    q: "¿Puedo financiar el curso?",
    // TODO: Confirmar y completar las opciones de financiación disponibles
    a: "[PENDIENTE: información sobre opciones de financiación — confirmar condiciones con el equipo]",
  },
  {
    q: "¿El curso incluye material o kit de uñas?",
    // TODO: Confirmar si el curso incluye kit de materiales y cuál es su contenido
    a: "[PENDIENTE: confirmar si el precio incluye kit de materiales y cuál es el contenido]",
  },
];

const standardIncludes = [
  "200 horas de contenido online",
  "Acceso inmediato a la plataforma",
  "Tutor personal asignado",
  "Tutorías ilimitadas en plataforma",
  "Evaluaciones prácticas",
  "Diploma acreditado de Esmera Online",
];
---

<LayoutLP
  title="Curso Profesional de Uñas Esmera"
  description="Conviértete en técnica de uñas profesional desde casa. 200 horas, 100% online, tutor incluido y diploma acreditado. ¡Empieza cuando quieras!"
>
  <!-- =====================================================
       1. HERO
  ====================================================== -->
  <section class="relative overflow-hidden bg-ink-950 py-20 sm:py-28">
    <div class="absolute inset-0 bg-dot-grid opacity-30 [mask-image:radial-gradient(ellipse_80%_70%_at_50%_0%,black,transparent)]"></div>
    <div class="absolute inset-0 bg-grain"></div>
    <div class="glow-orb -left-32 top-1/2 h-[32rem] w-[32rem] -translate-y-1/2 bg-brand-500/20"></div>
    <div class="glow-orb -right-20 top-0 h-64 w-64 bg-brand-400/10"></div>

    <div class="relative mx-auto w-full max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">

        <!-- Copy -->
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-1.5 text-sm font-medium text-brand-300">
            Formación profesional online · 200 horas
          </div>

          <h1 class="mt-5 font-display text-4xl font-semibold leading-tight text-white sm:text-5xl">
            Conviértete en técnica de uñas profesional
            <span class="text-brand-400"> desde casa</span>
          </h1>

          <p class="mt-5 text-lg leading-relaxed text-white/70">
            Aprende acrílicas, gel, semipermanente y nail art con tutor personal, a tu ritmo y con diploma acreditado incluido.
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            {features.map((f) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-medium text-white/80">
                <svg class="h-3 w-3 shrink-0 text-brand-400" viewBox="0 0 12 12" fill="currentColor">
                  <path d="M10.22 2.22a.75.75 0 0 1 0 1.06L5.06 8.44a.75.75 0 0 1-1.06 0L1.78 6.22a.75.75 0 0 1 1.06-1.06L4.53 6.85l4.63-4.63a.75.75 0 0 1 1.06 0Z"/>
                </svg>
                {f}
              </span>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              id="hero-cta-btn"
              href="#formulario"
              class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-7 py-4 font-display text-base font-semibold text-white shadow-[0_8px_32px_-8px_var(--color-brand-700)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-400"
            >
              Quiero información gratis
            </a>
            <a
              href={WA_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-6 py-4 text-sm font-semibold text-white transition-all duration-200 hover:bg-white/15"
            >
              <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
          </div>

          <p class="mt-5 flex items-center gap-2 text-sm text-white/50">
            <svg class="h-4 w-4 shrink-0 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
            Financiación disponible — consulta opciones sin compromiso
          </p>
        </div>

        <!-- Image -->
        <div class="relative">
          <div class="overflow-hidden rounded-3xl shadow-2xl shadow-black/40">
            <Image
              src={unasImg}
              alt="Trabajos profesionales de uñas — Esmera Online"
              width={600}
              height={500}
              loading="eager"
              fetchpriority="high"
              class="w-full object-cover"
            />
          </div>
          <div class="animate-float absolute -bottom-4 -left-4 rounded-2xl bg-white px-4 py-3 shadow-lg shadow-black/10">
            <p class="text-xs font-semibold text-ink-500">Alumnos formados</p>
            <p class="mt-0.5 font-display text-2xl font-bold text-ink-900">+1.000</p>
          </div>
          <div class="animate-float absolute -right-4 top-8 rounded-2xl bg-white px-4 py-3 shadow-lg shadow-black/10" style="animation-delay:2s">
            <p class="text-xs font-semibold text-ink-500">Valoración media</p>
            <p class="mt-0.5 font-display text-2xl font-bold text-brand-600">4,9 / 5</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Botón fijo en móvil — aparece cuando el CTA del hero sale de vista -->
  <div
    id="sticky-cta"
    class="fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 md:hidden"
    aria-hidden="true"
  >
    <div class="border-t border-ink-100 bg-white/95 p-3 backdrop-blur-sm">
      <a
        href="#formulario"
        class="block w-full rounded-lg bg-brand-600 py-3.5 text-center font-display text-sm font-semibold text-white shadow-lg"
      >
        Quiero información gratis
      </a>
    </div>
  </div>

  <!-- =====================================================
       2. PRUEBA SOCIAL
  ====================================================== -->
  <section class="border-y border-ink-100 bg-white py-12">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">
      <div data-reveal class="grid grid-cols-3 divide-x divide-ink-100 text-center">
        {[
          { value: "+1.000", label: "alumnos formados" },
          { value: "4,9/5",  label: "valoración media" },
          { value: "96%",    label: "satisfacción" },
        ].map(({ value, label }) => (
          <div class="px-4 py-2 sm:px-10">
            <p class="font-display text-2xl font-bold text-ink-900 sm:text-3xl">{value}</p>
            <p class="mt-1 text-xs text-ink-500 sm:text-sm">{label}</p>
          </div>
        ))}
      </div>

      <div data-reveal class="mt-10 border-t border-ink-100 pt-10">
        <p class="text-center text-xs font-medium uppercase tracking-widest text-ink-400">
          Formación con estándares de calidad reconocidos
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-8 sm:gap-12">
          <img src="/fundae.png" alt="FUNDAE" loading="lazy" class="h-12 w-auto object-contain opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0" />
          <img src="/Logo ANCYPEL rojo texto fondo blanco.png" alt="ANCYPEL" loading="lazy" class="h-12 w-auto object-contain opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0" />
          <img src="/sepelogo.png" alt="SEPE" loading="lazy" class="h-12 w-auto object-contain opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0" />
        </div>
        <p class="mt-5 text-center text-xs text-ink-400">ANCYPEL · ISO 21001 · UNE 66181 · Registro oficial de formación</p>
      </div>
    </div>
  </section>

  <!-- =====================================================
       3. PARA QUIÉN ES + OBJETIVOS
  ====================================================== -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal class="text-center">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-brand-600">¿Es para ti?</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Este curso es para ti si...</h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
        {audience.map(({ icon, title, desc }, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`} class="rounded-2xl border border-ink-100 bg-white p-6 shadow-sm shadow-ink-900/5">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={icon} class="h-6 w-6" />
            </div>
            <h3 class="mt-4 font-display text-lg font-semibold text-ink-900">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">{desc}</p>
          </div>
        ))}
      </div>

      <div data-reveal class="mt-16">
        <h3 class="font-display text-2xl font-semibold text-ink-900">Lo que vas a conseguir</h3>
        <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {objectives.map((obj) => (
            <div class="flex items-start gap-3 rounded-xl border border-ink-100 bg-ink-50 px-5 py-4">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
              </svg>
              <span class="text-sm leading-relaxed text-ink-700">{obj}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- =====================================================
       4. TEMARIO
  ====================================================== -->
  <!-- TODO: Rellenar temario con los módulos reales del curso -->
  <section class="bg-ink-50 py-16 sm:py-24">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="font-mono text-xs font-medium uppercase tracking-widest text-brand-600">Contenidos</p>
          <h2 class="mt-2 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Temario del curso</h2>
        </div>
        <span class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-white px-4 py-2 text-sm font-medium text-ink-600">
          <Icon name="clock" class="h-4 w-4 text-brand-600" />
          200 horas totales
        </span>
      </div>

      <div data-reveal class="mt-8 space-y-2">
        {temario.map((mod, i) => (
          <details class="group rounded-xl border border-ink-200 bg-white p-5 transition-colors open:border-brand-200 open:bg-brand-50/40">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-ink-900">
              <span class="flex items-center gap-3">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-brand-50 font-mono text-xs font-bold text-brand-700 transition-colors group-open:bg-brand-100">
                  {String(i + 1).padStart(2, "0")}
                </span>
                {mod}
              </span>
              <svg class="h-4 w-4 shrink-0 text-brand-500 transition-transform duration-250 group-open:rotate-180" viewBox="0 0 14 8" fill="none">
                <path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <p class="mt-3 pl-10 text-sm leading-relaxed text-ink-500">
              [PENDIENTE: descripción de los contenidos de este módulo]
            </p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- =====================================================
       5. CÓMO FUNCIONA
  ====================================================== -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal class="text-center">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-brand-600">El proceso</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Cómo funciona el curso</h2>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-5">
        {howItWorks.map(({ num, icon, title, desc }, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`} class="flex flex-col items-start lg:items-center lg:text-center">
            <span class="font-mono text-5xl font-bold text-brand-100">{num}</span>
            <div class="mt-3 flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600 lg:mx-auto">
              <Icon name={icon} class="h-5 w-5" />
            </div>
            <h3 class="mt-3 font-display text-base font-semibold text-ink-900">{title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =====================================================
       CTA MID-PAGE
  ====================================================== -->
  <section class="bg-brand-50 py-12 sm:py-16">
    <div data-reveal class="mx-auto w-full max-w-7xl px-6 lg:px-8 text-center">
      <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">¿Lista para dar el paso?</h2>
      <p class="mt-3 text-ink-500">Pide información sin compromiso y un asesor te resolverá todas las dudas.</p>
      <a
        href="#formulario"
        class="mt-6 inline-flex items-center justify-center rounded-lg bg-brand-600 px-8 py-4 font-display text-base font-semibold text-white shadow-[0_8px_32px_-8px_var(--color-brand-700)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-700"
      >
        Pide información ahora
      </a>
    </div>
  </section>

  <!-- =====================================================
       6. GALERÍA TRABAJOS DE ALUMNAS
  ====================================================== -->
  <!-- TODO: Sustituir los placeholders por fotos reales de trabajos de alumnas -->
  <section class="bg-ink-50 py-16 sm:py-24">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal class="text-center">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-brand-600">Resultados reales</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Trabajos de nuestras alumnas</h2>
        <p class="mt-3 text-ink-500">Lo que consiguen las alumnas que terminan el curso.</p>
      </div>

      <div data-reveal class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {Array.from({ length: 8 }).map((_, i) => (
          <div class="flex aspect-square items-center justify-center overflow-hidden rounded-2xl bg-ink-200">
            <span class="px-4 text-center text-xs text-ink-400">
              [PENDIENTE: foto trabajo alumna {i + 1}]
            </span>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =====================================================
       7. TESTIMONIOS
  ====================================================== -->
  <!-- TODO: Añadir testimonios reales de alumnas del curso de uñas -->
  <section class="py-16 sm:py-24">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal class="text-center">
        <p class="font-mono text-xs font-medium uppercase tracking-widest text-brand-600">Lo que dicen nuestras alumnas</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Testimonios</h2>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
        {Array.from({ length: 3 }).map((_, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`} class="rounded-2xl border border-ink-100 bg-white p-6 shadow-sm shadow-ink-900/5">
            <div class="flex gap-0.5">
              {Array.from({ length: 5 }).map(() => (
                <svg class="h-4 w-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="mt-4 text-sm leading-relaxed text-ink-600">
