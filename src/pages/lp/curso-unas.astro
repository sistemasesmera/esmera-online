<script>
  // Mostrar sticky CTA en móvil cuando el formulario sale de la vista
  const formulario = document.getElementById("formulario");
  const stickyBar  = document.getElementById("sticky-cta");

  if (formulario && stickyBar) {
    const obs = new IntersectionObserver(([entry]) => {
      const visible = entry.isIntersecting;
      stickyBar.classList.toggle("translate-y-full", visible);
      stickyBar.setAttribute("aria-hidden", String(visible));
    }, { threshold: 0 });
    obs.observe(formulario);
  }
</script>

