---
import LayoutLP from "../../layouts/LayoutLP.astro";
import LpLeadForm from "../../components/LpLeadForm.astro";
import Icon from "../../components/Icon.astro";

const COURSE_NAME    = "Curso Profesional de Uñas Esmera";
const PRICE          = 660;
const PRICE_ORIGINAL = 1400;
const SAVINGS        = PRICE_ORIGINAL - PRICE;
const DISCOUNT_PCT   = Math.round((SAVINGS / PRICE_ORIGINAL) * 100);
const WA_PHONE       = "34661043572";
const WA_MSG         = encodeURIComponent("¡Hola! Me interesa el Curso Profesional de Uñas Esmera. ¿Podéis darme más información?");
const WA_URL         = `https://wa.me/${WA_PHONE}?text=${WA_MSG}`;

const features = ["100% online", "6 meses de acceso", "Tutor incluido"] as const;

const audience = [
  {
    icon: "compass" as const,
    title: "Empiezas desde cero",
    desc: "No necesitas experiencia previa. Empezamos desde las bases y avanzamos paso a paso.",
  },
  {
    icon: "briefcase" as const,
    title: "Quieres trabajar por tu cuenta",
    desc: "Emprende tu propio negocio o ejerce como profesional autónoma con una formación sólida.",
  },
  {
    icon: "award" as const,
    title: "Quieres profesionalizarte",
    desc: "Ya conoces las bases y buscas una formación rigurosa para destacar en el sector.",
  },
];

const bloques = [
  {
    title: "Bloque 1 · Fundamentos",
    unidades: [
      "Introducción",
      "Unidad 1. Introducción a la Manicura y Pedicura",
      "Unidad 2. Higiene, Seguridad y Herramientas",
      "Unidad 3. Anatomía y Salud de Uñas",
    ],
  },
  {
    title: "Bloque 2 · Manicura, pedicura y esmaltado",
    unidades: [
      "Unidad 4. Manicura y Pedicura",
      "Unidad 5. Manicura y Pedicura SPA",
      "Unidad 6. Esmaltado de Uñas Tradicional",
      "Unidad 7. Esmaltado de Uñas Semipermanente",
      "Unidad 8. Usos de Torno",
    ],
  },
  {
    title: "Bloque 3 · Uñas esculpidas",
    unidades: [
      "Unidad 10. Uñas de Gel",
      "Unidad 11. Uñas Acrílico",
      "Unidad 12. Acrigel",
      "Unidad 13. Dual System",
      "Unidad 15. Reconstrucción de Uñas Mordidas",
    ],
  },
  {
    title: "Bloque 4 · Decoración y nail art",
    unidades: [
      "Unidad 9. Decoración de Uñas Básicas",
      "Unidad 14. Decoración de Uñas Avanzada",
      "Unidad 16. Decoración 3D",
    ],
  },
  {
    title: "Bloque 5 · Certificación",
    unidades: [
      "Examen final",
      "Proyecto final",
    ],
  },
];

const faqs = [
  {
    q: "¿Necesito experiencia previa para hacer este curso?",
    a: "No, el curso está diseñado desde cero. Empezamos por las bases y vamos avanzando paso a paso hasta las técnicas más demandadas.",
  },
  {
    q: "¿Tendré un tutor asignado?",
    a: "Sí, contarás con un tutor personal durante todo el curso para resolver tus dudas y guiarte en tu aprendizaje.",
  },
  {
    q: "¿Cuánto tiempo tengo para completar el curso?",
    a: "Tienes 6 meses de acceso desde el momento en que te matriculas. El curso tiene 200 horas de contenido, así que puedes organizarte perfectamente a tu ritmo dentro de ese plazo.",
  },
  {
    q: "¿Podré trabajar como profesional de uñas al terminar?",
    a: "Sí, el programa está orientado a la empleabilidad real. Al finalizar tendrás los conocimientos y la práctica necesarios para ejercer de forma profesional.",
  },
  {
    q: "¿Se puede financiar?",
    a: "Sí. Puedes pagar en un único pago, en 3 cuotas de 220 € sin intereses, o solicitar financiación a 6 o 12 meses. El asesor te explica las condiciones cuando te contacte.",
  },
];

const standardIncludes = [
  "200 horas de contenido online",
  "6 meses de acceso a la plataforma",
  "Tutor personal asignado",
  "Tutorías ilimitadas en plataforma",
  "Evaluaciones prácticas",
  "Diploma de Esmera Online al finalizar el curso",
];
---

<LayoutLP
  title="Curso Profesional de Uñas Esmera"
  description="Conviértete en profesional de uñas desde casa. 16 unidades, 200 horas, 100% online, tutor incluido y diploma de Esmera Online. ¡Empieza cuando quieras!"
>
  <!-- =====================================================
       1. HERO — texto izquierda + formulario derecha
  ====================================================== -->
  <section class="relative overflow-hidden bg-white py-12 sm:py-20">
    <div class="absolute inset-0 bg-dot-grid-light opacity-50 [mask-image:radial-gradient(ellipse_80%_60%_at_50%_0%,black,transparent)]"></div>

    <div class="relative mx-auto w-full max-w-7xl px-6 lg:px-8">
      <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2 lg:gap-16">

        <!-- Copy -->
        <div class="lg:pt-6">
          <div class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700 sm:px-4 sm:py-1.5 sm:text-sm">
            Formación profesional online · 200 horas
          </div>

          <h1 class="mt-4 font-display text-3xl font-semibold leading-tight text-ink-900 sm:text-4xl lg:text-5xl">
            Conviértete en profesional de uñas
            <span class="text-brand-600"> desde casa</span>
          </h1>

          <p class="mt-4 text-base leading-relaxed text-ink-600">
            Acrílicas, gel, semipermanente y nail art. Con tutor personal, a tu ritmo y diploma incluido.
          </p>

          <div class="mt-4 flex flex-wrap gap-2">
            {features.map((f) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-medium text-ink-700">
                <svg class="h-3 w-3 shrink-0 text-brand-600" viewBox="0 0 12 12" fill="currentColor">
                  <path d="M10.22 2.22a.75.75 0 0 1 0 1.06L5.06 8.44a.75.75 0 0 1-1.06 0L1.78 6.22a.75.75 0 0 1 1.06-1.06L4.53 6.85l4.63-4.63a.75.75 0 0 1 1.06 0Z"/>
                </svg>
                {f}
              </span>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-ink-500">
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Sin compromiso
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="h-4 w-4 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Respuesta en menos de 24h
            </span>
            <a href={WA_URL} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-ink-500 underline-offset-2 hover:text-ink-700 hover:underline">
              <svg class="h-4 w-4 shrink-0 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              También por WhatsApp
            </a>
          </div>

          <!-- Muestra de trabajos -->
          <div class="mt-6 flex gap-2">
            <img src="/images/trabajos/1.png" alt="Trabajo de alumna" class="h-20 w-20 rounded-xl object-cover sm:h-24 sm:w-24" loading="lazy" />
            <img src="/images/trabajos/10.png" alt="Trabajo de alumna" class="h-20 w-20 rounded-xl object-cover sm:h-24 sm:w-24" loading="lazy" />
            <img src="/images/trabajos/4.png" alt="Trabajo de alumna" class="h-20 w-20 rounded-xl object-cover sm:h-24 sm:w-24" loading="lazy" />
            <p class="flex items-center text-xs text-ink-400">Trabajos<br/>de alumnas</p>
          </div>

          <!-- Flecha hacia el formulario (solo móvil) -->
          <div class="mt-5 flex justify-center lg:hidden">
            <svg class="h-8 w-8 animate-bounce text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>

        <!-- Formulario -->
        <div id="formulario" class="scroll-mt-20">
          <LpLeadForm
            course={COURSE_NAME}
            redirectUrl="/lp/curso-unas/gracias"
            buttonText="Quiero información gratis"
            title="Pide información sin compromiso"
            subtitle="Un asesor te contactará en menos de 24h."
            variant="light"
            dataLayerValue={PRICE}
          />
          <p class="mt-3 text-center text-xs text-ink-400">
            Si no es lo que buscas, te lo decimos en la primera llamada. Sin compromiso.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Botón fijo en móvil -->
  <div
    id="sticky-cta"
    class="fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 md:hidden"
    aria-hidden="true"
  >
    <div class="border-t border-ink-100 bg-white/95 p-3 backdrop-blur-sm">
      <a
        href="#formulario"
        class="block w-full rounded-lg bg-brand-600 py-3.5 text-center font-display text-sm font-semibold text-white shadow-lg"
      >
        Quiero información gratis
      </a>
    </div>
  </div>

  <!-- =====================================================
       2. PRUEBA SOCIAL
  ====================================================== -->
  <section class="border-y border-ink-100 bg-white py-10">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">
      <div data-reveal class="grid grid-cols-3 divide-x divide-ink-100 text-center">
        {[
          { value: "+1.000", label: "alumnos formados" },
          { value: "4,9/5",  label: "valoración media" },
          { value: "96%",    label: "satisfacción" },
        ].map(({ value, label }) => (
          <div class="px-2 py-2 sm:px-10">
            <p class="font-display text-xl font-bold text-ink-900 sm:text-3xl">{value}</p>
            <p class="mt-0.5 text-xs text-ink-500 sm:text-sm">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================
       3. GALERÍA DE RESULTADOS
  ====================================================== -->
  <section class="bg-white py-10 sm:py-14">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">
      <p class="mb-5 text-center text-sm font-medium text-ink-500">Resultados de nuestras alumnas</p>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <img src="/images/trabajos/5.png" alt="Resultado alumna" class="aspect-square w-full rounded-2xl object-cover" loading="lazy" />
        <img src="/images/trabajos/6.png" alt="Resultado alumna" class="aspect-square w-full rounded-2xl object-cover" loading="lazy" />
        <img src="/images/trabajos/7.png" alt="Resultado alumna" class="aspect-square w-full rounded-2xl object-cover" loading="lazy" />
        <img src="/images/trabajos/8.png" alt="Resultado alumna" class="aspect-square w-full rounded-2xl object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- =====================================================
       4. PARA QUIÉN ES
  ====================================================== -->
  <section class="py-12 sm:py-20">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal class="text-center">
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-4xl">Este curso es para ti si...</h2>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3 sm:gap-6">
        {audience.map(({ icon, title, desc }, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`} class="rounded-2xl border border-ink-100 bg-white p-5 shadow-sm shadow-ink-900/5">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={icon} class="h-5 w-5" />
            </div>
            <h3 class="mt-3 font-display text-base font-semibold text-ink-900">{title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =====================================================
       5. PRECIO CON DESCUENTO
  ====================================================== -->
  <section class="bg-ink-50 py-12 sm:py-20">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal class="text-center">
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-3xl">Tu inversión</h2>
      </div>

      <div class="mx-auto mt-8 max-w-sm sm:max-w-md">
        <div data-reveal class="relative rounded-3xl border-2 border-brand-500 bg-white p-6 shadow-xl shadow-brand-900/10 sm:p-8">

          <!-- Badge descuento -->
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 whitespace-nowrap">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-red-600 px-4 py-1.5 text-sm font-bold text-white shadow-lg shadow-red-900/30">
              <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 0 1 0 1.414l-7 7a1 1 0 0 1-1.414 0l-7-7A.997.997 0 0 1 2 10V5a3 3 0 0 1 3-3h5c.256 0 .512.098.707.293l7 7ZM5 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/>
              </svg>
              -{DISCOUNT_PCT}% · Ahorras {SAVINGS} €
            </span>
          </div>

          <!-- Precio -->
          <div class="mt-5 flex items-end gap-3">
            <p class="font-display text-5xl font-bold text-ink-900 sm:text-6xl">
              {PRICE}<span class="text-2xl font-medium text-ink-400 sm:text-3xl"> €</span>
            </p>
            <div class="mb-1.5">
              <p class="text-sm font-semibold text-red-500 line-through">{PRICE_ORIGINAL} €</p>
              <p class="text-xs text-ink-400">Precio habitual</p>
            </div>
          </div>
          <div class="mt-3 space-y-1">
            <p class="text-sm text-ink-600">Pago único o en 3 cuotas de 220 € sin intereses</p>
            <p class="text-xs text-ink-400">También financiación a 6 o 12 meses · Consulta condiciones</p>
          </div>

          <!-- Includes -->
          <ul class="mt-5 space-y-2.5">
            {standardIncludes.map((item) => (
              <li class="flex items-center gap-2.5 text-sm text-ink-600">
                <svg class="h-4 w-4 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <a
            href="#formulario"
            class="mt-5 flex w-full items-center justify-center rounded-lg bg-brand-600 px-6 py-4 font-display text-base font-semibold text-white shadow-[0_8px_20px_-8px_var(--color-brand-700)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-brand-700"
          >
            Quiero información gratis
          </a>

        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================
       5. SALIDAS PROFESIONALES
  ====================================================== -->
  <section class="bg-ink-50 py-12 sm:py-20">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal class="text-center">
        <h2 class="mt-2 font-display text-2xl font-semibold text-ink-900 sm:text-4xl">¿Qué puedes hacer al terminar?</h2>
        <p class="mt-3 text-sm text-ink-500 sm:text-base">El sector de la belleza crece cada año. Aquí tienes las salidas reales que abre este curso.</p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {([
          { icon: "users",     title: "Atender clientes en casa",        desc: "Crea tu propio espacio y trabaja con tu clientela sin depender de nadie." },
          { icon: "briefcase", title: "Trabajar en centros de estética", desc: "Entra al mercado laboral como profesional de uñas en salones y centros de belleza." },
          { icon: "chart",     title: "Abrir tu propio negocio",         desc: "Crea tu marca, fija tus precios y construye un negocio rentable desde cero." },
          { icon: "brush",     title: "Especializarte en nail art",      desc: "Diferénciate con técnicas avanzadas de decoración y atrae a clientas exigentes." },
          { icon: "clock",     title: "Trabajar de forma autónoma",      desc: "Sin horarios fijos ni jefes. Tú decides cuándo, dónde y para quién trabajas." },
          { icon: "compass",   title: "Crecer en un sector con futuro",   desc: "La demanda de profesionales de uñas sube cada año. Donde vivas, siempre hay clientas buscando una buena profesional." },
        ] as { icon: "users"|"briefcase"|"chart"|"brush"|"clock"|"compass"; title: string; desc: string }[]).map(({ icon, title, desc }) => (
          <div data-reveal class="flex items-start gap-4 rounded-2xl border border-ink-100 bg-white p-5 shadow-sm">
            <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={icon} class="h-5 w-5" />
            </div>
            <div>
              <h3 class="font-display text-sm font-semibold text-ink-900">{title}</h3>
              <p class="mt-1 text-xs leading-relaxed text-ink-500">{desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- =====================================================
       6. TEMARIO
  ====================================================== -->
  <section class="bg-ink-50 py-12 sm:py-20">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal>
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-4xl">Temario del curso</h2>
        <p class="mt-2 text-sm text-ink-500">16 unidades · 200 horas · 6 meses de acceso · Examen y proyecto final</p>
      </div>

      <div data-reveal class="mt-5 space-y-2">
        {bloques.map(({ title, unidades }, i) => (
          <details open={i === 0} class="group rounded-xl border border-ink-200 bg-white transition-colors open:border-brand-200 open:bg-brand-50/40">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 text-sm font-semibold text-ink-900 sm:p-5">
              {title}
              <svg class="h-4 w-4 shrink-0 text-brand-500 transition-transform duration-250 group-open:rotate-180" viewBox="0 0 14 8" fill="none">
                <path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <ul class="space-y-2 px-4 pb-4 sm:px-5 sm:pb-5">
              {unidades.map((u) => (
                <li class="flex items-center gap-2.5 text-sm text-ink-600">
                  <svg class="h-3.5 w-3.5 shrink-0 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                  </svg>
                  {u}
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- =====================================================
       7. FAQ
  ====================================================== -->
  <section class="bg-ink-50 py-12 sm:py-20">
    <div class="mx-auto w-full max-w-7xl px-6 lg:px-8">

      <div data-reveal class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-2xl font-semibold text-ink-900 sm:text-4xl">Preguntas frecuentes</h2>
      </div>

      <div data-reveal class="mx-auto mt-8 max-w-3xl space-y-2">
        {faqs.map(({ q, a }) => (
          <details class="group rounded-2xl border border-ink-100 bg-white p-4 transition-colors open:border-brand-200 open:bg-brand-50/40 sm:p-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-ink-900">
              {q}
              <svg class="h-4 w-4 shrink-0 text-brand-600 transition-transform duration-300 group-open:rotate-180" viewBox="0 0 14 8" fill="none">
                <path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <p class="mt-3 animate-[fadeIn_0.3s_ease-out] text-sm leading-relaxed text-ink-500">{a}</p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- =====================================================
       8. CTA FINAL
  ====================================================== -->
  <section class="relative overflow-hidden bg-ink-950 py-16 sm:py-20">
    <div class="absolute inset-0 bg-dot-grid opacity-20"></div>
    <div class="absolute inset-0 bg-grain"></div>
    <div class="glow-orb -left-20 top-1/2 h-96 w-96 -translate-y-1/2 bg-brand-500/20"></div>

