---
import LayoutLP from "../../../layouts/LayoutLP.astro";

const WA_PHONE = "34661043572";
const WA_MSG   = encodeURIComponent("¡Hola! Acabo de solicitar información sobre el Curso Profesional de Uñas Esmera. ¿Podéis ayudarme?");
const WA_URL   = `https://wa.me/${WA_PHONE}?text=${WA_MSG}`;
---

<LayoutLP
  title="¡Gracias por tu solicitud! — Curso Profesional de Uñas Esmera"
  description="Hemos recibido tu solicitud. Un asesor de Esmera Online te contactará en breve."
>
  <section class="flex min-h-[70vh] items-center justify-center py-20">
    <div class="mx-auto w-full max-w-lg px-6 text-center">

      <!-- Icono de éxito -->
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-brand-50">
        <svg class="h-10 w-10 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"/>
        </svg>
      </div>

      <h1 class="mt-6 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
        ¡Solicitud recibida!
      </h1>

      <p class="mt-4 text-lg leading-relaxed text-ink-500">
        Un asesor de Esmera Online se pondrá en contacto contigo en menos de 24&nbsp;horas para resolver todas tus dudas sobre el <strong class="font-semibold text-ink-700">Curso Profesional de Uñas</strong>.
      </p>

      <p class="mt-3 text-sm text-ink-400">
        Mientras tanto, si tienes alguna pregunta urgente, escríbenos directamente por WhatsApp.
      </p>

      <a
        href={WA_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center gap-3 rounded-lg bg-[#25D366] px-7 py-4 font-display text-base font-semibold text-white shadow-lg shadow-black/10 transition-all duration-200 hover:-translate-y-0.5 hover:brightness-110"
      >
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Escríbenos por WhatsApp
      </a>

    </div>
  </section>
</LayoutLP>
