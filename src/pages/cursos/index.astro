---
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/ui/Container.astro";
import Eyebrow from "../../components/ui/Eyebrow.astro";
import CourseCard from "../../components/CourseCard.astro";
import { getCollection } from "astro:content";

const allCourses = (await getCollection("courses")).sort((a, b) => a.data.order - b.data.order);
const allCategories = await getCollection("categories");

const topCategories = allCategories.filter((c) => !c.data.parent).sort((a, b) => a.data.order - b.data.order);

const usedCategoryIds = [...new Set(allCourses.flatMap((c) => c.data.categories.map((cat) => cat.id)))];
const courseCategories = allCategories
  .filter((c) => usedCategoryIds.includes(c.id))
  .sort((a, b) => a.data.order - b.data.order);

const grouped = courseCategories.map((category) => {
  const courses = allCourses.filter((c) => c.data.categories.some((cat) => cat.id === category.id));
  return { category, main: courses.slice(0, 2), more: courses.slice(2) };
});
---

<Layout
  title="Todos los cursos"
  description="Explora toda la formación profesional online de Esmera Online: IA, marketing, desarrollo web, diseño y más sectores."
>
  <section class="relative overflow-hidden border-b border-ink-100 bg-gradient-to-b from-brand-50 to-white py-16 sm:py-20">
    <div class="absolute inset-x-0 top-0 -z-10 h-full bg-dot-grid-light opacity-60 [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"></div>

    <Container class="relative">
      <div data-reveal>
        <Eyebrow>Catálogo</Eyebrow>
        <h1 class="mt-4 font-display text-4xl font-semibold text-ink-900 sm:text-5xl">Todos los cursos</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-500">
          Formación con tutor asignado, tutorías semanales y proyectos reales. Elige tu sector y empieza tu próximo paso profesional.
        </p>
      </div>

      <div data-reveal style="--reveal-delay: 100ms" class="mt-8 flex flex-wrap gap-2">
        <a href="/cursos" class="rounded-full bg-ink-900 px-4 py-2 text-sm font-medium text-white transition-transform duration-200 hover:-translate-y-0.5">Todos</a>
        {
          topCategories.map((category) => (
            <a
              href={`/categorias/${category.id}`}
              class="rounded-full border border-ink-200 px-4 py-2 text-sm font-medium text-ink-700 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-300 hover:text-brand-700"
            >
              {category.data.name}
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="py-16">
    <Container>
      <div class="space-y-16">
        {
          grouped.map(({ category, main, more }) => (
            <div>
              <div data-reveal class="mb-6 flex items-center gap-3">
                <h2 class="font-display text-2xl font-semibold text-ink-900">{category.data.name}</h2>
                <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">
                  {main.length + more.length} cursos
                </span>
              </div>

              <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {main.map((course, index) => (
                  <div data-reveal style={`--reveal-delay: ${index * 80}ms`}>
                    <CourseCard course={course} />
                  </div>
                ))}
              </div>

              {more.length > 0 && (
                <details class="group mt-6">
                  <summary class="flex w-fit cursor-pointer list-none items-center gap-2 rounded-full border border-ink-200 px-5 py-2.5 text-sm font-medium text-ink-700 transition-all duration-200 hover:border-brand-300 hover:text-brand-700 [&::-webkit-details-marker]:hidden">
                    <svg
                      class="h-4 w-4 transition-transform duration-200 group-open:rotate-180"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                    <span class="group-open:hidden">Ver más cursos de {category.data.name} ({more.length})</span>
                    <span class="hidden group-open:inline">Ocultar cursos de {category.data.name}</span>
                  </summary>

                  <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    {more.map((course) => (
                      <CourseCard course={course} />
                    ))}
                  </div>
                </details>
              )}
            </div>
          ))
        }
      </div>
    </Container>
  </section>
</Layout>
