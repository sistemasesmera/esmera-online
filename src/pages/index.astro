---
import Layout from "../layouts/Layout.astro";
import Container from "../components/ui/Container.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import CourseCard from "../components/CourseCard.astro";
import CategoryCard from "../components/CategoryCard.astro";
import Icon from "../components/Icon.astro";
import { Icon as HeroIcon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroImage from "../assets/hero/hero-study.png";

const categories = (await getCollection("categories")).filter((c) => !c.data.parent).sort((a, b) => a.data.order - b.data.order);
const courses = await getCollection("courses");
const catalogIds = ["prl-peluqueria-estetica", "prl-basico-peluqueria", "cejas-pestanas"];
const featuredCourses = catalogIds.map((id) => courses.find((c) => c.id === id)).filter((c) => c !== undefined);

const courseCountByCategory = new Map<string, number>();
for (const course of courses) {
  for (const category of course.data.categories) {
    courseCountByCategory.set(category.id, (courseCountByCategory.get(category.id) ?? 0) + 1);
  }
}

const journeySteps = [
  { title: "Acceso inmediato", description: "En cuanto te matriculas accedes a la plataforma y puedes empezar el mismo día." },
  { title: "Tutor incluido", description: "Se te asigna un tutor desde el primer día, disponible en la plataforma para resolver tus dudas." },
  { title: "Tutorías en la plataforma", description: "Consulta a tu tutor cuando lo necesites, directamente desde la plataforma, sin esperas." },
  { title: "Evaluaciones y seguimiento", description: "Completa las actividades y evaluaciones a tu ritmo para consolidar lo aprendido." },
  { title: "Certificado profesional", description: "Terminas con un diploma o certificado profesional que acredita tu formación." },
];

const benefits = [
  { title: "Tutor incluido", description: "Cada curso incluye un tutor asignado que resuelve tus dudas a través de la plataforma.", icon: "chat" as const },
  { title: "Tutorías en la plataforma", description: "Consulta a tu tutor cuando lo necesites, sin necesidad de citas ni llamadas.", icon: "calendar" as const },
  { title: "Certificado acreditado", description: "Obtén tu diploma al finalizar, válido para acreditar tu formación ante cualquier empresa o inspección.", icon: "award" as const },
  { title: "Contenidos siempre actualizados", description: "Formación al día con lo que el mercado laboral demanda hoy.", icon: "refresh" as const },
  { title: "Orientación profesional", description: "Te ayudamos a dar el siguiente paso: empleo, especialización o emprendimiento.", icon: "compass" as const },
  { title: "100% online y flexible", description: "Estudia desde donde quieras, sin renunciar a tu trabajo o tu agenda actual.", icon: "clock" as const },
];

const delayStyle = (index: number, step = 80) => `--reveal-delay: ${index * step}ms`;
---

<Layout
  title="Esmera Online — Hazte profesional en lo que te apasiona"
  description="Formación online con tutor propio, tutorías semanales y certificado incluido. Prevención de riesgos laborales, imagen personal y más."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-white pt-4 pb-20 sm:py-28">
    <div class="absolute inset-x-0 top-0 -z-10 h-[640px] bg-gradient-to-b from-brand-50 to-white"></div>
    <div class="absolute inset-x-0 top-0 -z-10 h-[640px] bg-dot-grid opacity-[0.35] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"></div>
    <svg class="absolute inset-0 -z-10 h-full w-full text-brand-300/60 [mask-image:radial-gradient(ellipse_60%_55%_at_50%_30%,black,transparent)]" preserveAspectRatio="none">
      <defs>
        <pattern id="hero-circuit" width="72" height="72" patternUnits="userSpaceOnUse">
          <g fill="none" stroke="currentColor" stroke-width="1">
            <path d="M0 18H18V0" />
            <path d="M36 0V18H54V36" />
            <path d="M72 54H54V72" />
            <path d="M18 72V54H0" />
            <path d="M36 36H72" />
            <path d="M0 54H18V36" />
          </g>
          <g fill="currentColor">
            <circle cx="18" cy="18" r="1.6" />
            <circle cx="54" cy="36" r="1.6" />
            <circle cx="18" cy="54" r="1.6" />
            <circle cx="36" cy="36" r="1.6" />
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-circuit)" />
    </svg>
    <div class="glow-orb -right-32 top-10 -z-10 h-96 w-96 bg-brand-300/25"></div>
    <div class="glow-orb -left-24 bottom-0 -z-10 h-72 w-72 bg-brand-200/30"></div>

    <Container class="relative">
      <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-2">
        <div>
          <h1 data-reveal style={delayStyle(0)} class="mt-5 font-display text-4xl font-bold tracking-tight text-ink-900 sm:text-6xl">
            Hazte profesional en lo que te apasiona.<br />
            <span class="relative text-brand-600">
              Empieza a trabajar.
              <svg viewBox="0 0 360 12" preserveAspectRatio="none" class="absolute -bottom-1 left-0 h-2.5 w-full text-brand-300/70 sm:-bottom-2">
                <path d="M2 9.5C60 2 280 1 358 8" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
              </svg>
            </span>
          </h1>
          <p data-reveal style={delayStyle(2)} class="mt-7 max-w-xl text-lg font-normal leading-relaxed text-ink-500">
            Sin horarios. Sin desplazamientos. Con tutor incluido y certificado al terminar. Formación online que se adapta a tu vida.
          </p>
          <div data-reveal style={delayStyle(3)} class="mt-10 flex flex-col items-start gap-3 sm:flex-row">
            <Button href="/cursos" variant="primary" size="lg">Explorar cursos</Button>
            <Button href="javascript:void(0)" variant="secondary" size="lg" data-lead-modal-trigger>Habla con un asesor</Button>
          </div>
          <p data-reveal style={delayStyle(4)} class="mt-4 text-sm text-ink-400">
            ¿Quieres financiarlo? <a href="javascript:void(0)" data-lead-modal-trigger class="text-brand-600 underline underline-offset-2 hover:text-brand-700">Habla con un asesor.</a>
          </p>
        </div>

        <div data-reveal style={delayStyle(2)} class="relative mx-auto w-full max-w-md lg:max-w-none">
          <div class="absolute -inset-8 -z-10 rounded-[3rem] bg-gradient-to-br from-brand-200/50 via-brand-100/40 to-transparent blur-2xl"></div>
          <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-300 via-brand-400 to-brand-600 p-[3px] shadow-2xl shadow-ink-900/20">
            <div class="relative h-full w-full overflow-hidden rounded-[calc(2rem-3px)]">
              <Image src={heroImage} alt="Alumno organizando su plan de formación" width={700} height={875} class="h-full w-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-ink-950/25 via-transparent to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Confianza -->
  <section class="border-y border-ink-100 py-14">
    <Container>
      <!-- Métricas -->
      <div data-reveal class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 sm:gap-x-20">
        {
          [
            { value: "+1.000", label: "alumnos formados" },
            { value: "4,9/5",  label: "valoración media" },
            { value: "96%",    label: "satisfacción del alumno" },
          ].map((stat) => (
            <div class="min-w-[120px] text-center">
              <p class="font-display text-5xl font-bold tabular-nums text-ink-900">{stat.value}</p>
              <p class="mt-2 text-base text-ink-500">{stat.label}</p>
            </div>
          ))
        }
      </div>

      <!-- Separador -->
      <div class="my-10 flex items-center gap-4">
        <div class="h-px flex-1 bg-ink-100"></div>
        <p class="text-xs font-medium uppercase tracking-widest text-ink-400">Formación con estándares de calidad reconocidos</p>
        <div class="h-px flex-1 bg-ink-100"></div>
      </div>

      <!-- Logos -->
      <div data-reveal class="flex flex-wrap items-center justify-center gap-10 sm:gap-16">
        <img src="/fundae.png" alt="FUNDAE" class="h-20 w-auto object-contain" />
        <img src="/Logo ANCYPEL rojo texto fondo blanco.png" alt="ANCYPEL" class="h-20 w-auto object-contain" />
        <img src="/sepelogo.png" alt="SEPE" class="h-20 w-auto object-contain" />
      </div>

      <!-- Sellos -->
      <p data-reveal class="mt-6 text-center text-xs font-medium tracking-wide text-ink-400">
        ANCYPEL · ISO 21001 · UNE 66181 · Registro oficial de formación
      </p>
    </Container>
  </section>

  <!-- Beneficios -->
  <section class="py-24">
    <Container>
      <div data-reveal class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
          Esto es lo que incluye tu formación
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-500">
          Tutor incluido, plataforma siempre disponible y certificado al terminar.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          benefits.map((benefit, index) => (
            <div
              data-reveal
              style={delayStyle(index % 3)}
              class="group relative rounded-2xl border border-ink-100 p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-brand-200 hover:shadow-lg hover:shadow-ink-900/5"
            >
              <span class="absolute right-5 top-5 font-mono text-xs text-ink-200 transition-colors duration-300 group-hover:text-brand-300">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-700 transition-transform duration-300 group-hover:-rotate-6">
                <Icon name={benefit.icon} class="h-5 w-5" />
              </div>
              <h3 class="font-display text-base font-semibold text-ink-900">{benefit.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">{benefit.description}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Cómo funciona -->
  <section class="relative overflow-hidden bg-ink-950 py-24 text-white">
    <div class="absolute inset-0 bg-grain"></div>
    <div class="absolute inset-0 bg-dot-grid opacity-[0.15] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,black,transparent)]"></div>
    <div class="glow-orb left-1/2 top-0 h-80 w-80 -translate-x-1/2 bg-brand-500/20"></div>

    <Container class="relative">
      <div data-reveal class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-semibold sm:text-4xl">Tu recorrido como alumno</h2>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-5">
        {
          journeySteps.map((step, index) => (
            <div data-reveal style={delayStyle(index)} class="relative border-t border-white/10 pt-5">
              <span class="font-mono text-sm text-brand-400">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="mt-3 font-display text-base font-semibold">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-300">{step.description}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Categorías -->
  <section class="py-24">
    <Container>
      <div data-reveal class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <Eyebrow>Sectores</Eyebrow>
          <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Formación en múltiples sectores</h2>
        </div>
        <Button href="/cursos" variant="ghost">Ver todos los cursos →</Button>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((category, index) => (
            <div data-reveal style={delayStyle(index % 3)}>
              <CategoryCard category={category} courseCount={courseCountByCategory.get(category.id) ?? 0} />
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Cursos destacados -->
  <section class="bg-ink-50/60 py-24">
    <Container>
      <div data-reveal class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <Eyebrow>Catálogo</Eyebrow>
          <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">Empieza por aquí</h2>
        </div>
        <Button href="/cursos" variant="ghost">Ver todos los cursos →</Button>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredCourses.map((course, index) => (
            <div data-reveal style={delayStyle(index % 4)}>
              <CourseCard course={course} />
            </div>
          ))
        }
      </div>
    </Container>
  </section>


</Layout>
